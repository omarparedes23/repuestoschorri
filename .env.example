# Copiar a .env.local y completar con los datos reales del negocio.
# Número de WhatsApp en formato internacional, sin "+" ni espacios (Perú: 51 + 9 dígitos).
NEXT_PUBLIC_WHATSAPP_NUMBER=51934892800
# URL pública del sitio (sin slash final). Usada en metadata, canonical, sitemap y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://repuestoschorry.pe

# Supabase - catalogo (publishable/anon key; protegida por RLS, solo lectura)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
